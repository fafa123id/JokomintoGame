NODE_ENV=development
PORT=3000

# Required in production, min 32 random characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. OAuth Web Client ID; add your origin to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Optional. Enables the online image pool for "Guess the Picture" (https://pixabay.com/api/docs/).
PIXABAY_API_KEY=

# Behind reverse proxies: a hop count (e.g. 2) or "loopback, linklocal, uniquelocal" to trust private hops.
TRUST_PROXY=

# Defaults to server/storage/database/game.db
DB_FILE=

# Defaults to server/storage/cache/images
IMAGE_CACHE_DIR=

# Inactive guest accounts are removed after this many days.
GUEST_TTL_DAYS=30

# docker-compose: host port for the app (bind to localhost, put nginx/Caddy in front).
APP_PORT=3000

# Domain handled by the external nginx-proxy/acme-companion stack.
DOMAIN=game.example.com
LETSENCRYPT_EMAIL=

# Browser push notifications (Web Push). Generate once with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Hours between automatic stat decay steps (hygiene -10, hunger +10, mood -10).
NEEDS_DECAY_HOURS=2
NEEDS_REMIND_HOURS=6
